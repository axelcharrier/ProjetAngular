    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.4",
    "@primeuix/themes": "^2.0.2",
    "@tailwindcss/postcss": "^4.1.18",
    "express": "^5.1.0",
    "postcss": "^8.5.6",
    "primeng": "^21.0.2",
    "rxjs": "~7.8.0",
